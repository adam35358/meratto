# ========================================================
# MERATTO & DE FRANKO — TELEGRAM BOT CONFIG TEMPLATE
# ========================================================

# 1. Telegram Bot Sozlamalari (Netlify Environment Variables orqali beriladi)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 2. Admin Panel Paroli
ADMIN_PASSWORD=your_admin_password_here

# 3. Bepul Cloud Storage (ImgBB - https://api.imgbb.com dan bepul olinadi)
IMGBB_API_KEY=

# 4. Standalone Server Porti
PORT=5000
